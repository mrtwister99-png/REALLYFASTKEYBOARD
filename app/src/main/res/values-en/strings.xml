    <string name="about_title">fAZT!</string>
    <string name="about_tagline">A fast, private keyboard</string>
    <string name="about_p1">A fast Czech and English keyboard with swipe typing across the letters. It learns your words and corrections.</string>
    <string name="about_p2">Start dictation by holding Enter, with your own voice commands. Plus macros with shortcuts and a clipboard history.</string>
    <string name="about_p3">Customize both the look and the key layout. Works offline, with no ads and no telemetry.</string>
    <string name="about_p4">Your data stays on the phone and can be backed up to a file.</string>
