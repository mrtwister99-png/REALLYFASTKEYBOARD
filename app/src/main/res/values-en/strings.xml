    <string name="sec_backup">Tuning</string>
    <string name="backup_open">Backup and restore</string>
    <string name="backup_how">How it works: “Save” writes the keyboard settings, personal dictionary, corrections, macros, swipe adaptation and the swipe log into one file. “Restore” loads it back: settings are overwritten (saved styles 1–5 are merged with yours), dictionary and macros are merged with what you already have. Of the clipboard history only pinned items (up to 100) are included.</string>
    <string name="backup_privacy">No data goes anywhere: the keyboard has no internet access and you save and load the file yourself, wherever you like. Everything stays with you. The backup is not encrypted, keep it somewhere safe.</string>
    <string name="backup_export">Save keyboard settings (export)</string>
    <string name="backup_import">Restore keyboard settings (import)</string>
    <string name="backup_exported">Backup saved</string>
    <string name="backup_export_failed">Could not save the backup</string>
    <string name="backup_restore_confirm">Restore from backup? Settings will be overwritten (saved styles 1–5 are merged with yours), dictionary and macros will be merged with what you already have.</string>
    <string name="backup_restore">Restore</string>
    <string name="backup_restored">Restored, accepted words: %1$d</string>
    <string name="backup_restore_failed">The file is not a valid fAZT! backup</string>
    <string name="swipe_log">Record swipes for tuning</string>
    <string name="swipe_log_hint">When on, every swipe that types a word is saved: the finger path and the word you confirmed. The last 1000 swipes are kept, the oldest are dropped as new ones arrive. It stays on the phone only and is never saved in password fields. It is for tuning swipe accuracy; you can export it and it is included in the backup. Off by default.</string>
